<!DOCTYPE html>
<html lang="en" class="govuk-template--rebranded">
  <head>
    <title><%= [yield(:page_title).presence, t('service.name')].compact.join(' - ') %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="viewport" content="width=device-width initial-scale=1">
    <meta property="og:image" content="<%= asset_path('images/moj-opengraph-image-2024.png') %>">
    <meta name="theme-color" content="#0b0c0c">
    <%= favicon_link_tag image_path('images/moj-logotype-crest-2024.png'), type: 'image/png' %>
    <%= favicon_link_tag image_path('images/moj-logotype-crest-2024.svg'),
          type: 'image/svg+xml', rel: 'mask-icon', color: "#0b0c0c" %>
    <%= favicon_link_tag image_path('images/moj-apple-touch-icon-180x180-2024.png'), rel: 'apple-touch-icon', type: nil %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="govuk-template__body">
    <script nonce="<%= request.content_security_policy_nonce %>">
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>

    <%= govuk_skip_link %>

    <%= moj_header(organisation_name: "Legal Aid Agency", url: "https://intranet.justice.gov.uk/?agency=laa") do |header| %>
      <% if current_user %>
        <%= header.with_navigation_item(text: current_user.full_name,
                                        href: user_path(current_user.id),
                                        current: current_page?(user_path(current_user&.id))) %>
        <%= header.with_navigation_item(text: t("layouts.sign_out"),
                                        href: destroy_user_session_path) %>
      <% end %>
    <% end %>

    <%= govuk_service_navigation(service_name: t("service.name"), service_url: "/") do |header| %>
      <% if current_user %>
        <%= header.with_navigation_item(
          text: t("layouts.checked_details"),
          href: bulk_submissions_path,
          active: current_page?(bulk_submissions_path) || current_page?(authenticated_root_path)) %>
      <% end %>
    <% end %>

    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content" role="main">
        <% if flash[:error] %>
          <div class="govuk-error-summary">
            <h2 class="govuk-error-summary__title"><%= flash[:error] %></h2>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <%= govuk_notification_banner(
                title_text: t("generic.important"),
                text: flash[:alert],
              ) %>
        <% end %>

        <% if flash[:notice] %>
          <%= govuk_notification_banner(
                title_text: t("generic.important"),
                text: flash[:notice],
              ) %>
        <% end %>

        <%= yield %>
      </main>
    </div>

    <%= govuk_footer %>
  </body>
</html>
